manifest {
    name = 'brca-sv-amp-timing-nf'
    description = 'SVclone and AmplificationTimeR timing for the BRCA SASH cohort'
    nextflowVersion = '>=24.04.0'
    mainScript = 'main.nf'
}

params {
    svclone_manifest = null
    amptimer_inputs  = null
    outdir           = null
    samples          = null      // optional comma-separated subset
    run_svclone      = true
    run_amptimer     = true
    snv_subsample    = 10000
    amptimer_commit  = '5ea87b02f31e3d0dce4f76dd5f6938ae2295df80'
    run_amptimer_gw  = false     // genome-wide: every gained CN segment
    amptimer_gw_inputs = null
    amptimer_gw_chunk  = 8       // samples per task (each task installs the R packages once)
    amptimer_check_full = false  // also rerun each chunk passing the whole mutation table, to check equality
}

process {
    withName: SVCLONE {
        container = 'quay.io/biocontainers/svclone:1.1.4--pyr44hdfd78af_0'
        cpus = 4
        memory = { 16.GB * task.attempt }
        time = { 12.h * task.attempt }
        maxForks = 30
        errorStrategy = { task.exitStatus in ((130..145) + 104 + 2147483647) ? 'retry' : 'finish' }
        maxRetries = 2
    }
    withName: 'AMPTIMER|AMPTIMER_GW' {
        container = 'bioconductor/bioconductor_docker@sha256:8c131494af2c1a4a8ff16656ac486e72fd0d1b135d4c06e54f17bf63cd3b86a3'
        cpus = 4
        memory = 16.GB
        time = 6.h
        errorStrategy = { task.exitStatus in ((130..145) + 104 + 2147483647) ? 'retry' : 'finish' }
        maxRetries = 2
    }
}

docker.enabled = true
